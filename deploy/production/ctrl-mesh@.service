[Unit]
Description=ctrl-mesh Devnet voter %i
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ctrl-mesh
Group=ctrl-mesh
WorkingDirectory=/opt/ctrl-mesh/current
EnvironmentFile=/etc/ctrl-mesh/common.env
EnvironmentFile=/etc/ctrl-mesh/%i.env
ExecStart=/opt/ctrl-mesh/node/bin/node dist/platform-server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ctrl-mesh

[Install]
WantedBy=multi-user.target
