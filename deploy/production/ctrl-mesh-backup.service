[Unit]
Description=Private ctrl-mesh SQLite and identity backup

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/ctrl-mesh/current/deploy/production/backup.py
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ctrl-mesh /var/lib/ctrl-mesh
